{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current C++ file",
      "type": "shell",
      "command": "g++",
      "args": ["-std=c++17","-O2","${file}","-o","/tmp/run_bin","&&","/tmp/run_bin"],
      "group": "build",
      "presentation": {"echo": true, "reveal": "always"},
      "problemMatcher": "$gcc"
    }
  ]
}
